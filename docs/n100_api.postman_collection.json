      "name": "Companies",
      "item": [
        {
          "name": "Get Companies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/v1/companies?sector=&market_cap_category=&search=",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "api",
                "v1",
                "companies"
              ],
              "query": [
                {
                  "key": "sector",
                  "value": "",
                  "description": "Broad sector to filter by"
                },
                {
                  "key": "market_cap_category",
                  "value": "",
                  "description": "Market cap category to filter by"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Partial search on ticker or company name"
                }
              ]
            },
            "description": "Returns a list of all companies with their ID, name, sector, sub-sector, market cap category, ROE, and ROCE.\nSupports query parameters for filtering and searching."
          }
        },
        {
          "name": "Get Company Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/v1/companies/{ticker}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "api",
                "v1",
                "companies",
                "{ticker}"
              ]
            },
            "description": "Returns general details and the latest year's financial ratios/KPIs, sector details,\nas well as pros and cons from pre-analyzed outputs for a specific company ticker."
          }
        },
