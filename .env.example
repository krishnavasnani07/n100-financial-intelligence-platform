# ====================================================================
# Nifty 100 Financial Intelligence Platform - Environment Config
# ====================================================================
# Copy this file to '.env' in the root directory and update as needed.

# Application Deployment Mode: 'development', 'production', or 'testing'
ENV=development

# Verbose console output and reloading toggles
DEBUG=True

# Database Configuration (Relative or absolute path)
DB_PATH=db/nifty100.db

# Logging Configuration
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
