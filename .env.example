# ====================================================================
# N100 Financial Intelligence Platform - Environment Template
# ====================================================================
# Copy this file to '.env' and modify variables as per your local setup.

# Application Environment: 'development', 'production', or 'testing'
ENV=development

# Enable debug mode (verbose console output and Streamlit reloaders)
DEBUG=True

# Relative or absolute path to SQLite database store
DB_PATH=db/nifty100.db

# Logging Configuration
# Allowed levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
